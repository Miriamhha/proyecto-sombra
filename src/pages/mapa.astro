---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Mapa de espacios | Sombra Cerca">
  <Header />

  <main class="max-w-7xl mx-auto px-6 py-10">

    <section class="mb-8">
      <p class="text-green-700 font-semibold uppercase tracking-wider text-sm">
        Explora geográficamente
      </p>

      <h1 class="text-3xl md:text-4xl font-bold text-green-950 mt-2">
        Mapa de espacios verdes
      </h1>

      <p class="text-gray-600 mt-3">
        Ubica los parques y plazas de Andahuaylas y sus alrededores.
      </p>
    </section>

    <div
      id="mapa"
      class="w-full h-[500px] rounded-2xl shadow-lg border border-gray-200"
    >
    </div>

  </main>

  <Footer />
</Layout>

<script>
  import "../scripts/mapa.js";
</script>
