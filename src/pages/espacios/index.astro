
---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Filtro from "../../components/Filtro.astro";
import CardEspacio from "../../components/CardEspacio.astro";
import { espacios } from "../../data/espacios.js";
---

<Layout title="Explorar espacios | Sombra Cerca">

  <!-- ENCABEZADO -->
  <Header />

  <main class="max-w-7xl mx-auto px-6 py-12">

    <!-- TITULO -->
    <section class="mb-10">
      <p class="text-green-700 font-semibold uppercase tracking-wider text-sm">
        Explora tu ciudad
      </p>

      <h1 class="text-4xl font-bold text-green-950 mt-2 mb-4">
        Encuentra tu espacio ideal
      </h1>

      <p class="text-gray-600">
        Descubre parques, plazas y espacios para caminar y descansar.
      </p>
    </section>

    <!-- BUSCADOR Y FILTROS -->
    <Filtro />

    <!-- CONTADOR -->
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-green-950">
        Nuestros espacios
      </h2>

      <p id="contador" class="text-green-800 font-semibold">
        {espacios.length} espacios encontrados
      </p>
    </div>

    <!-- TARJETAS -->
    <section
      id="contenedor-espacios"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
    >

      {espacios.map((lugar) => (
        <CardEspacio lugar={lugar} />
      ))}

    </section>

    <!-- MENSAJE SIN RESULTADOS -->
    <div id="sin-resultados" class="hidden text-center py-16">
      <p class="text-5xl mb-4">🔎</p>

      <h3 class="text-2xl font-bold text-gray-800">
        No encontramos espacios
      </h3>

      <p class="text-gray-500 mt-2">
        Prueba cambiando los filtros de búsqueda.
      </p>
    </div>

  </main>

  <!-- PIE DE PÁGINA -->
  <Footer />

</Layout>

<!-- JAVASCRIPT DE LOS FILTROS -->
<script>
  import "../../scripts/filtros.js";
  import "../../scripts/favoritos.js";
</script>
