---
import Layout from "../../layouts/Layout.astro";
import { espacios } from "../../data/espacios.js";
---

<Layout title="Explorar espacios | Sombra Cerca">

  <!-- ENCABEZADO -->
  <header class="bg-white shadow-sm">
    <nav class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center flex-wrap gap-4">
      <a href="/" class="text-2xl font-bold text-green-800">
        🌳 Sombra Cerca
      </a>

      <div class="flex gap-5 items-center">
        <a href="/" class="text-gray-600 hover:text-green-700">Inicio</a>
        <a href="/espacios/" class="text-green-800 font-bold">Espacios</a>
        <a href="/favoritos/" class="text-gray-600 hover:text-green-700">Favoritos ♡</a>
      </div>
    </nav>
  </header>

  <main class="max-w-7xl mx-auto px-6 py-12">

    <!-- TITULO -->
    <section class="mb-10">
      <p class="text-green-700 font-semibold uppercase tracking-wider text-sm">
        Explora tu ciudad
      </p>

      <h1 class="text-4xl font-bold text-green-950 mt-2 mb-4">
        Encuentra tu espacio ideal
      </h1>

      <p class="text-gray-600">
        Descubre parques, plazas y espacios para caminar y descansar.
      </p>
    </section>

    <!-- BUSCADOR Y FILTROS -->
    <section class="bg-green-50 rounded-2xl p-6 mb-10">

      <h2 class="text-xl font-bold text-green-900 mb-5">
        Buscar espacios
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

        <div>
          <label for="busqueda" class="block text-sm font-semibold mb-2">
            Buscar por nombre o zona
          </label>
          <input
            id="busqueda"
            type="search"
            placeholder="Ej. Pacucha..."
            class="w-full bg-white border border-gray-300 rounded-lg p-3 outline-none focus:ring-2 focus:ring-green-600"
          />
        </div>

        <div>
          <label for="tipo" class="block text-sm font-semibold mb-2">
            Tipo de espacio
          </label>
          <select
            id="tipo"
            class="w-full bg-white border border-gray-300 rounded-lg p-3"
          >
            <option value="">Todos los tipos</option>
            <option value="parque">Parques</option>
            <option value="plaza">Plazas</option>
            <option value="alameda">Alamedas</option>
          </select>
        </div>

        <div>
          <label for="sombra" class="block text-sm font-semibold mb-2">
            Nivel de sombra
          </label>
          <select
            id="sombra"
            class="w-full bg-white border border-gray-300 rounded-lg p-3"
          >
            <option value="">Todos los niveles</option>
            <option value="alta">Alta</option>
            <option value="media">Media</option>
            <option value="baja">Baja</option>
          </select>
        </div>

        <div>
          <label for="asientos" class="block text-sm font-semibold mb-2">
            Disponibilidad de asientos
          </label>
          <select
            id="asientos"
            class="w-full bg-white border border-gray-300 rounded-lg p-3"
          >
            <option value="">Todos</option>
            <option value="si">Con asientos</option>
            <option value="no">Sin asientos</option>
          </select>
        </div>

      </div>

      <button
        id="limpiar"
        type="button"
        class="mt-5 bg-green-800 text-white px-6 py-3 rounded-lg hover:bg-green-900 transition"
      >
        Limpiar filtros
      </button>

    </section>

    <!-- CONTADOR -->
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-green-950">
        Nuestros espacios
      </h2>

      <p id="contador" class="text-green-800 font-semibold">
        {espacios.length} espacios encontrados
      </p>
    </div>

    <!-- TARJETAS -->
    <section
      id="contenedor-espacios"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
    >

      {espacios.map((lugar) => (

        <article
          class="tarjeta-espacio bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition"
          data-nombre={lugar.nombre.toLowerCase()}
          data-zona={lugar.zona.toLowerCase()}
          data-tipo={lugar.tipo.toLowerCase()}
          data-sombra={lugar.sombra ?? ""}
          data-asientos={lugar.asientos === true ? "si" : lugar.asientos === false ? "no" : "sin-info"}
        >

          <img
            src={lugar.imagen}
            alt={`Fotografía de ${lugar.nombre}`}
            class="w-full h-56 object-cover"
            loading="lazy"
          />

          <div class="p-6">

            <span class="inline-block bg-green-100 text-green-800 text-xs font-bold uppercase px-3 py-1 rounded-full">
              {lugar.tipo}
            </span>

            <h3 class="text-xl font-bold text-gray-900 mt-3 mb-2">
              {lugar.nombre}
            </h3>

            <p class="text-gray-500 text-sm mb-4">
              📍 {lugar.zona}
            </p>

            <div class="border-t border-gray-100 pt-4 space-y-3">

              <p class="text-sm text-gray-700">
             🌳 <strong>Sombra:</strong> {lugar.sombra ?? "Sin información"}
            </p>

            <p class="text-sm text-gray-700">
            🪑 <strong>Asientos:</strong>
             {lugar.asientos === true ? "Sí" : lugar.asientos === false ? "No" : "Sin información"}
            </p>

            </div>
            

          </div>

        </article>

      ))}

    </section>

    <!-- MENSAJE SIN RESULTADOS -->
    <div id="sin-resultados" class="hidden text-center py-16">
      <p class="text-5xl mb-4">🔎</p>
      <h3 class="text-2xl font-bold text-gray-800">
        No encontramos espacios
      </h3>
      <p class="text-gray-500 mt-2">
        Prueba cambiando los filtros de búsqueda.
      </p>
    </div>

  </main>

  <!-- PIE DE PAGINA -->
  <footer class="bg-green-950 text-white text-center py-8 mt-12">
    <p class="font-semibold">Sombra Cerca 🌳</p>
    <p class="text-green-200 text-sm mt-2">
      Espacios para caminar, descansar y disfrutar.
    </p>
  </footer>

</Layout>

<!-- JAVASCRIPT PARA LOS FILTROS -->
<script>
  const busqueda = document.querySelector("#busqueda") as HTMLInputElement;
  const tipo = document.querySelector("#tipo") as HTMLSelectElement;
  const sombra = document.querySelector("#sombra") as HTMLSelectElement;
  const asientos = document.querySelector("#asientos") as HTMLSelectElement;
  const limpiar = document.querySelector("#limpiar") as HTMLButtonElement;

  const tarjetas = document.querySelectorAll(".tarjeta-espacio");
  const contador = document.querySelector("#contador");
  const sinResultados = document.querySelector("#sin-resultados");

  function filtrarEspacios() {
    const texto = busqueda.value.toLowerCase().trim();
    const tipoSeleccionado = tipo.value;
    const sombraSeleccionada = sombra.value;
    const asientosSeleccionados = asientos.value;

    let encontrados = 0;

    tarjetas.forEach((elemento) => {
      const tarjeta = elemento as HTMLElement;

      const nombre = tarjeta.dataset.nombre || "";
      const zona = tarjeta.dataset.zona || "";
      const tipoLugar = tarjeta.dataset.tipo || "";
      const nivelSombra = tarjeta.dataset.sombra || "";
      const tieneAsientos = tarjeta.dataset.asientos || "";

      const coincideTexto =
        nombre.includes(texto) || zona.includes(texto);

      const coincideTipo =
        !tipoSeleccionado || tipoLugar === tipoSeleccionado;

      const coincideSombra =
        !sombraSeleccionada || nivelSombra === sombraSeleccionada;

      const coincideAsientos =
        !asientosSeleccionados || tieneAsientos === asientosSeleccionados;

      const coincide =
        coincideTexto &&
        coincideTipo &&
        coincideSombra &&
        coincideAsientos;

      tarjeta.classList.toggle("hidden", !coincide);

      if (coincide) {
        encontrados++;
      }
    });

    if (contador) {
      contador.textContent = `${encontrados} espacios encontrados`;
    }

    if (sinResultados) {
      sinResultados.classList.toggle("hidden", encontrados !== 0);
    }
  }

  busqueda.addEventListener("input", filtrarEspacios);
  tipo.addEventListener("change", filtrarEspacios);
  sombra.addEventListener("change", filtrarEspacios);
  asientos.addEventListener("change", filtrarEspacios);

  limpiar.addEventListener("click", () => {
    busqueda.value = "";
    tipo.value = "";
    sombra.value = "";
    asientos.value = "";

    filtrarEspacios();
  });
</script>
