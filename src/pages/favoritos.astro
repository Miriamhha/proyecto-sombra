---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Mis favoritos | Sombra Cerca">

  <Header />

  <main class="max-w-6xl mx-auto px-6 py-10">

    <section class="mb-8">
      <h1 class="text-3xl font-bold text-gray-800">
        Mis espacios favoritos ❤️
      </h1>

      <p class="text-gray-600 mt-2">
        Aquí encontrarás los espacios que guardaste para visitar después.
      </p>
    </section>

    <!-- LISTA DE FAVORITOS -->
    <div
      id="lista-favoritos"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
    >
    </div>

    <!-- MENSAJE CUANDO NO HAY FAVORITOS -->
    <p
      id="mensaje-vacio"
      class="hidden text-center py-12 text-gray-500"
    >
      Todavía no tienes espacios favoritos.
      Explora el catálogo y guarda los lugares que más te gusten.
    </p>

    <a
      href="/espacios/"
      class="inline-block mt-8 bg-green-700 text-white px-5 py-3 rounded-lg hover:bg-green-800"
    >
      Explorar espacios
    </a>

  </main>

  <Footer />

</Layout>

<script>
  import "../scripts/favoritos.js";
</script>
