---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Comparador de espacios | Sombra Cerca">
  <Header />

  <main class="max-w-7xl mx-auto px-6 py-10">

    <!-- ENCABEZADO -->
    <section class="mb-8">
      <p class="text-green-700 font-semibold uppercase tracking-wider text-sm">
        Encuentra tu mejor opción
      </p>

      <h1 class="text-3xl md:text-4xl font-bold text-green-950 mt-2">
        Comparador de espacios
      </h1>

      <p class="text-gray-600 mt-3">
        Compara las características de parques y plazas para encontrar
        el espacio que mejor se adapte a tus necesidades.
      </p>
    </section>

    <!-- CONTENEDOR DE COMPARACIÓN -->
    <section class="bg-white rounded-2xl shadow-md p-6">

      <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
        <h2 class="text-xl font-bold text-gray-800">
          Espacios seleccionados
        </h2>

        <button
          id="limpiar-comparador"
          class="text-red-600 hover:text-red-800 font-semibold text-sm"
        >
          Limpiar comparación
        </button>
      </div>

      <!-- AQUÍ SE MOSTRARÁ LA TABLA -->
      <div id="contenido-comparador">
        <p class="text-gray-500 text-center py-8">
          Cargando espacios seleccionados...
        </p>
      </div>

      <div class="mt-8">
        <a
          href="/espacios/"
          class="inline-block bg-green-800 text-white px-5 py-3 rounded-lg hover:bg-green-900 transition"
        >
          + Agregar espacios
        </a>
      </div>

    </section>

  </main>

  <Footer />
  <script>
  import "../scripts/comparador-pagina.js";
</script>
</Layout>
